<script id="asenha-external-permalinks-js-after">
(function () {
   'use strict';

   document.addEventListener( 'DOMContentLoaded', function () {

      var links = document.getElementsByTagName( 'a' );

      for ( var i = 0; i < links.length; i++ ) {
         var url = links[i].getAttribute( 'href' );

         if ( url == null ) {
            continue;
         }

         var hasAsenhaEp = url.indexOf( '#asenha_ep' ) >= 0;

         if ( ! hasAsenhaEp ) {
            continue;
         }

         url = url.replace( '#asenha_ep', '' );
         links[i].setAttribute( 'href', url );
         links[i].setAttribute( 'rel', 'noopener noreferrer nofollow' );
      }

   } );

} )();
//# sourceURL=asenha-external-permalinks-js-after
</script>
