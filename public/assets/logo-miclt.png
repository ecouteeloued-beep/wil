    margin-top: 0px ;
    margin-right: 10px !important ;
    margin-bottom: 0px;
    margin-left: 5px ;
}
.hp-form--wide {
    display: flex;
    align-items: flex-start !important;
}
.wide-1218 .inner-wrap {
    max-width: 100%;
}
#header-text-nav-wrap {
    padding-top: 5px;
    padding-bottom: 5px;
    max-width: 1218px !important;
    margin: auto !important;
}
   #site-navigation {
    width: 96% !important;
		   background: #131e71;
		   background: linear-gradient(to bottom, #113061, #131e71) !important;
}
.spacious-header-display-four .bottom-menu .header-action {
    padding-top: 0px;
     background: linear-gradient(to bottom, #113061, #131e71) !important;
    width: 4% !important;
}
 #mega-menu-wrap-primary {
      
        background: linear-gradient(to bottom, #113061, #131e71);
        width: 100% !important;
	 max-width:1380px !important;
	 margin:auto !important;
    }
#main {
    padding: 0px 0 10px 0;
    max-width: 1218px !important;
    margin: auto;
}
.footer-widgets-area {
    padding-top: 30px;
    padding-bottom: 10px;
    color: #999;
    max-width: 1218px !important;
    margin: auto;
}
.header-post-title-class {
    font-size: 1.5rem !important;
    color: #122669;
    font-weight: bold;
    margin: 5px;
}

</style>
